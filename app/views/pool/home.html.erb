<% content_for(:title) { current_tournament.name } %>

<%# Hero %>
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-black to-gray-900"></div>
  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 py-20 sm:py-28 text-center">
    <h1 class="text-4xl sm:text-6xl font-bold tracking-tight text-white">
      World Cup 2026 Finals
    </h1>
    <p class="mt-5 text-lg text-white/80 max-w-xl mx-auto">
      Predice quién avanza en cada partido. Punto extra por atinar al marcador.
      Suma puntos y gana un premio.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <% if user_signed_in? && current_entry&.paid? %>
        <%= link_to "Hacer predicciones", predictions_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-black bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
      <% elsif user_signed_in? %>
        <%= link_to "Inscribirme (#{number_to_currency(current_tournament.entry_fee, unit: '$', precision: 0)} #{current_tournament.currency})", new_entry_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-black bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
      <% else %>
        <%= link_to "Crear cuenta", new_user_registration_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-black bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
        <%= link_to "Iniciar sesión", new_user_session_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-white border border-white/30 rounded-lg hover:bg-white/10 transition-colors" %>
      <% end %>
      <%= link_to "Ver partidos", bracket_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-white border border-white/30 rounded-lg hover:bg-white/10 transition-colors" %>
    </div>
  </div>
</section>

<div class="mx-auto max-w-2xl px-4 sm:px-6 py-10 space-y-8">
  <%= render "shared/prize_banner", tournament: current_tournament, participants_count: @participants_count %>

  <%# Próximos partidos %>
  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-[var(--color-foreground)]">Próximos partidos</h2>
      <%= link_to "Leaderboard", leaderboard_path, class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
    </div>
    <% if @next_matches.any? %>
      <div class="space-y-2">
        <% @next_matches.each do |match| %>
          <div class="flex items-center justify-between rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-3 text-sm">
            <div class="min-w-0">
              <span class="text-xs text-[var(--color-muted-foreground)]"><%= match.stage_name %></span>
              <p class="font-medium truncate"><%= team_label(match.display_home) %> <span class="text-[var(--color-muted-foreground)]">vs</span> <%= team_label(match.display_away) %></p>
            </div>
            <span class="text-xs text-[var(--color-muted-foreground)] flex-shrink-0 ml-3">
              <%= match.kickoff_at.in_time_zone(StudioSetting.studio_timezone).strftime("%d/%m %H:%M") %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay partidos programados.</p>
    <% end %>
  </section>

  <%# Cómo funciona %>
  <section>
    <h2 class="text-lg font-semibold text-[var(--color-foreground)] mb-3">Cómo funciona</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      <% [
        [ "M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z", "Inscríbete", "Un pago único de acceso al torneo." ],
        [ "M9 12.75 11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z", "Predice", "Elige quién avanza en cada partido. Punto extra si atinas el marcador." ],
        [ "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z", "Suma puntos", "Las rondas más avanzadas valen más. Sigue tu posición en el leaderboard." ],
        [ "M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0", "Gana", "El que más puntos acumule se lleva el premio." ]
      ].each do |icon, title, desc| %>
        <div class="flex gap-3 rounded-[var(--radius-md)] border border-[var(--color-border)] p-4">
          <svg class="h-6 w-6 flex-shrink-0 text-[var(--color-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="<%= icon %>"/></svg>
          <div>
            <p class="font-medium text-[var(--color-foreground)]"><%= title %></p>
            <p class="text-sm text-[var(--color-muted-foreground)] mt-0.5"><%= desc %></p>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
