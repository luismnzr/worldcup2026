<% content_for(:title) { current_tournament.name } %>

<%# Hero %>
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-gray-900 via-black to-gray-900"></div>
  <div class="relative mx-auto max-w-3xl px-4 sm:px-6 py-20 sm:py-28 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-white/60">Quiniela entre amigos</p>
    <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight text-white">
      <%= current_tournament.name %>
    </h1>
    <p class="mt-5 text-lg text-white/80 max-w-xl mx-auto">
      Predice quién avanza en cada partido de la eliminación directa. Los cruces se van
      abriendo conforme se definen los equipos.
    </p>
    <div class="mt-8 flex flex-wrap gap-3 justify-center">
      <% if user_signed_in? && current_entry&.paid? %>
        <%= link_to "Hacer predicciones", predictions_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-[var(--color-primary)] bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
      <% elsif user_signed_in? %>
        <%= link_to "Inscribirme (#{number_to_currency(current_tournament.entry_fee, unit: '$', precision: 0)} #{current_tournament.currency})", new_entry_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-[var(--color-primary)] bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
      <% else %>
        <%= link_to "Crear cuenta", new_user_registration_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-[var(--color-primary)] bg-white rounded-lg hover:bg-gray-50 transition-colors shadow-lg" %>
        <%= link_to "Iniciar sesión", new_user_session_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-white border border-white/30 rounded-lg hover:bg-white/10 transition-colors" %>
      <% end %>
      <%= link_to "Ver bracket", bracket_path, class: "inline-flex items-center px-6 py-3 text-sm font-semibold text-white border border-white/30 rounded-lg hover:bg-white/10 transition-colors" %>
    </div>
  </div>
</section>

<div class="mx-auto max-w-2xl px-4 sm:px-6 py-10 space-y-8">
  <%= render "shared/prize_banner", tournament: current_tournament, participants_count: @participants_count %>

  <%# Próximos partidos %>
  <section>
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-lg font-semibold text-[var(--color-foreground)]">Próximos partidos</h2>
      <%= link_to "Tabla", leaderboard_path, class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
    </div>
    <% if @next_matches.any? %>
      <div class="space-y-2">
        <% @next_matches.each do |match| %>
          <div class="flex items-center justify-between rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-3 text-sm">
            <div class="min-w-0">
              <span class="text-xs text-[var(--color-muted-foreground)]"><%= match.stage_name %></span>
              <p class="font-medium truncate"><%= match.display_home %> <span class="text-[var(--color-muted-foreground)]">vs</span> <%= match.display_away %></p>
            </div>
            <span class="text-xs text-[var(--color-muted-foreground)] flex-shrink-0 ml-3">
              <%= match.kickoff_at.in_time_zone(StudioSetting.studio_timezone).strftime("%d/%m %H:%M") %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay partidos programados.</p>
    <% end %>
  </section>
</div>
