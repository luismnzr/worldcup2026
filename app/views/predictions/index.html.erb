<% content_for(:title) { "Predicciones" } %>

<div class="mx-auto max-w-2xl px-4 sm:px-6 py-6 sm:py-10">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-[var(--color-foreground)]">Tus predicciones</h1>
      <p class="text-sm text-[var(--color-muted-foreground)] mt-1">Elige quién avanza en cada partido abierto.</p>
    </div>
    <%= link_to "Tabla", leaderboard_path, class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
  </div>

  <% if @open_matches.any? %>
    <div class="space-y-4">
      <% @open_matches.each do |match| %>
        <%= render "predictions/match", match: match, prediction: (@predictions[match.id] || current_user.predictions.build(match: match)) %>
      <% end %>
    </div>
  <% else %>
    <%= render Ui::CardComponent.new do %>
      <div class="text-center py-8">
        <p class="text-sm text-[var(--color-muted-foreground)]">No hay partidos abiertos por ahora.</p>
        <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Las predicciones se abren conforme se definen los equipos de cada cruce.</p>
      </div>
    <% end %>
  <% end %>

  <% if @locked_matches.any? %>
    <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)] mt-10 mb-3">Partidos cerrados</h2>
    <div class="space-y-2">
      <% @locked_matches.each do |match| %>
        <% prediction = @predictions[match.id] %>
        <div class="flex items-center justify-between rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-3 text-sm">
          <div class="min-w-0">
            <span class="text-xs text-[var(--color-muted-foreground)]"><%= match.stage_name %></span>
            <p class="font-medium truncate"><%= match.display_home %> vs <%= match.display_away %></p>
          </div>
          <div class="text-right flex-shrink-0 ml-3">
            <% if match.status == "finished" %>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= match.home_score %>–<%= match.away_score %> · avanza <%= match.advancing_team %></p>
            <% end %>
            <% if prediction&.advancing_pick.present? %>
              <p class="text-xs <%= prediction.points_awarded.positive? ? 'text-[var(--color-success)]' : 'text-[var(--color-muted-foreground)]' %>">
                Tu pick: <%= prediction.advancing_pick %><%= " · +#{prediction.points_awarded}" if match.status == "finished" %>
              </p>
            <% else %>
              <p class="text-xs text-[var(--color-muted-foreground)]">Sin predicción</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
