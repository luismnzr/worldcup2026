<%#
  Tarjeta de partido para el bracket. locals: match
%>
<%= link_to match_path(match), class: "tb-card-link" do %>
<div class="tb-card">
  <div class="tb-card-top">
    <span class="tb-card-status">
      <% if match.status == "finished" %>
        <%= match.home_score == match.away_score ? "PEN" : "FT" %>
      <% elsif match.kickoff_at.present? %>
        <%= match.kickoff_at.in_time_zone(StudioSetting.studio_timezone).strftime("%d/%m · %H:%M") %>
      <% else %>
        —
      <% end %>
    </span>
    <span class="tb-card-num">P<%= match.number %></span>
  </div>

  <% [ [ match.display_home, match.home_team, match.home_score ],
       [ match.display_away, match.away_team, match.away_score ] ].each do |label, team, score| %>
    <% advanced = team.present? && match.advancing_team == team %>
    <div class="tb-team <%= "tb-team--win" if advanced %>">
      <span class="tb-team-name" title="<%= label %>"><%= team_label(label) %></span>
      <span class="tb-team-score"><%= score %></span>
    </div>
  <% end %>

  <% prediction = @my_predictions && @my_predictions[match.id] %>
  <% if match.venue.present? || prediction&.advancing_pick.present? %>
    <div class="tb-card-foot">
      <span class="tb-card-venue"><%= "📍 #{match.venue}" if match.venue.present? %></span>
      <% if prediction&.advancing_pick.present? %>
        <% pick = flag_emoji(prediction.advancing_pick) || prediction.advancing_pick %>
        <% if match.status == "finished" && match.advancing_team.present? %>
          <% hit = prediction.correct? %>
          <span class="tb-card-pick <%= hit ? "tb-card-pick--hit" : "tb-card-pick--miss" %>">
            <%= pick %> <%= hit ? "✓ +#{prediction.points_awarded}" : "✗" %>
          </span>
        <% else %>
          <span class="tb-card-pick">Tu pick: <%= pick %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
<% end %>
