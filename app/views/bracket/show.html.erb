<% content_for(:title) { "Bracket" } %>

<div class="mx-auto max-w-3xl px-4 sm:px-6 py-6 sm:py-10">
  <h1 class="text-2xl font-bold text-[var(--color-foreground)] mb-1">Bracket</h1>
  <p class="text-sm text-[var(--color-muted-foreground)] mb-6">Eliminación directa — <%= current_tournament.name %></p>

  <% Match::STAGES.each do |stage| %>
    <% matches = @matches_by_stage[stage] %>
    <% next unless matches&.any? %>
    <section class="mb-8">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)] mb-3">
        <%= matches.first.stage_name %>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <% matches.each do |match| %>
          <div class="rounded-[var(--radius-md)] border border-[var(--color-border)] px-4 py-3">
            <div class="flex items-center justify-between text-xs text-[var(--color-muted-foreground)] mb-1.5">
              <span>P<%= match.number %></span>
              <% if match.status == "finished" %>
                <%= render Ui::BadgeComponent.new(text: "Final", variant: :secondary) %>
              <% elsif match.kickoff_at.present? %>
                <span><%= match.kickoff_at.in_time_zone(StudioSetting.studio_timezone).strftime("%d/%m %H:%M") %></span>
              <% end %>
            </div>
            <div class="space-y-1 text-sm">
              <div class="flex items-center justify-between <%= 'font-bold text-[var(--color-primary)]' if match.advancing_team.present? && match.advancing_team == match.home_team %>">
                <span class="truncate"><%= match.display_home %></span>
                <% if match.home_score.present? %><span class="ml-2 tabular-nums"><%= match.home_score %></span><% end %>
              </div>
              <div class="flex items-center justify-between <%= 'font-bold text-[var(--color-primary)]' if match.advancing_team.present? && match.advancing_team == match.away_team %>">
                <span class="truncate"><%= match.display_away %></span>
                <% if match.away_score.present? %><span class="ml-2 tabular-nums"><%= match.away_score %></span><% end %>
              </div>
            </div>
            <% if match.venue.present? %>
              <p class="text-xs text-[var(--color-muted-foreground)] mt-1.5"><%= match.venue %></p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
