<% content_for(:title) { "Bracket" } %>

<%
  seg_base = "px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
  seg_on   = "bg-[var(--color-background)] text-[var(--color-foreground)] shadow-[var(--shadow-sm)]"
  seg_off  = "text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]"
%>

<div class="mx-auto max-w-[1700px] px-3 sm:px-6 py-5 sm:py-8">
  <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
    <div>
      <h1 class="text-2xl font-bold text-[var(--color-foreground)]">Bracket</h1>
      <p class="text-sm text-[var(--color-muted-foreground)]">Eliminación directa · <%= current_tournament.name %></p>
    </div>

    <div class="inline-flex items-center gap-0.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-muted)] p-0.5">
      <%= link_to "Por rondas", bracket_path, class: "#{seg_base} #{@view == "rondas" ? seg_on : seg_off}" %>
      <%= link_to "Ver todos los partidos", bracket_path(view: "todos"), class: "#{seg_base} #{@view == "todos" ? seg_on : seg_off}" %>
    </div>
  </div>

  <% if @view == "todos" %>
    <%= render "bracket/tree" %>
  <% else %>
    <%= render "bracket/tabs" %>
  <% end %>
</div>
