<% content_for(:title) { "Mi Perfil" } %>

<% entry = @user.entry_for(Tournament.current) %>

<div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-4">
      <div class="h-14 w-14 rounded-2xl bg-[var(--color-primary)] flex items-center justify-center">
        <span class="text-xl font-bold text-white"><%= @user.display_name_or_default[0]&.upcase %></span>
      </div>
      <div>
        <h1 class="text-xl font-bold text-[var(--color-foreground)]"><%= @user.display_name_or_default %></h1>
        <p class="text-sm text-[var(--color-muted-foreground)]"><%= @user.email %></p>
      </div>
    </div>
    <%= link_to edit_user_registration_path,
          class: "inline-flex items-center justify-center h-9 px-4 text-sm font-medium text-[var(--color-foreground)] border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors" do %>
      Editar perfil
    <% end %>
  </div>

  <%# Estado en el torneo %>
  <div class="bg-white rounded-2xl border border-[var(--color-border)] p-6">
    <p class="text-sm font-medium text-[var(--color-muted-foreground)] mb-2">Torneo</p>
    <% if entry&.paid? %>
      <p class="text-xl font-bold text-[var(--color-foreground)]">Inscrito al torneo</p>
      <p class="text-sm text-[var(--color-muted-foreground)] mt-1">Tu acceso está activo. ¡A predecir!</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <%= link_to "Hacer predicciones", predictions_path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
        <%= link_to "Leaderboard", leaderboard_path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-[var(--color-foreground)] border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors" %>
      </div>
    <% else %>
      <p class="text-xl font-bold text-[var(--color-foreground)]">No estás inscrito</p>
      <p class="text-sm text-[var(--color-muted-foreground)] mt-1">Inscríbete para jugar la quiniela.</p>
      <div class="mt-4">
        <%= link_to "Inscribirme", new_entry_path, class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
      </div>
    <% end %>
  </div>
</div>
