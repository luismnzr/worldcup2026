<% content_for(:title) { "Mis Pedidos" } %>

<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-xl font-bold text-[var(--color-foreground)] mb-6">Mis Pedidos</h1>

  <%= render "tabs" %>

  <% if @orders.any? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-[var(--color-muted)]/50">
            <tr>
              <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Pedido</th>
              <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Fecha</th>
              <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Artículos</th>
              <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Estado</th>
              <th class="px-5 py-3 text-right font-medium text-[var(--color-muted-foreground)]">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--color-border)]">
            <% @orders.each do |order| %>
              <tr class="hover:bg-[var(--color-muted)]/30">
                <td class="px-5 py-3.5">
                  <%= link_to "##{order.id}", profile_order_path(order), class: "font-medium text-[var(--color-foreground)] hover:text-[var(--color-primary)] hover:underline" %>
                </td>
                <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= l(order.created_at, format: "%d/%m/%Y") %></td>
                <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]">
                  <%= order.order_items.first&.product&.name %>
                  <% if order.order_items.size > 1 %>
                    <span class="text-xs">+ <%= order.order_items.size - 1 %> más</span>
                  <% end %>
                </td>
                <td class="px-5 py-3.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                              <%= case order.shipping_status
                                  when 'unfulfilled' then 'bg-amber-50 text-amber-700'
                                  when 'fulfilled'   then 'bg-blue-50 text-blue-700'
                                  when 'shipped'     then 'bg-violet-50 text-violet-700'
                                  when 'delivered'   then 'bg-emerald-50 text-emerald-700'
                                  end %>">
                    <%= t_shipping_status(order.shipping_status) %>
                  </span>
                </td>
                <td class="px-5 py-3.5 font-medium text-right"><%= number_to_currency(order.total) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-12 text-center">
      <p class="text-[var(--color-muted-foreground)] mb-4">Aún no tienes pedidos.</p>
      <%= link_to "Ir a la tienda", products_path,
            class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
    </div>
  <% end %>
</div>
