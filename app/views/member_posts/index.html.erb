<% content_for(:title) { "Contenido de Miembros" } %>

<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--color-foreground)]">Contenido para Miembros</h1>
    <p class="text-[var(--color-muted-foreground)] mt-2">Recursos exclusivos para nuestra comunidad de suscriptores.</p>
  </div>

  <% unless current_user&.has_active_subscription? %>
    <div class="bg-gradient-to-br from-[var(--color-primary)]/10 to-[var(--color-accent)]/10 border border-[var(--color-primary)]/30 rounded-xl p-6 mb-8 flex items-start gap-4">
      <svg class="h-6 w-6 text-[var(--color-primary)] flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      <div class="flex-1">
        <p class="font-semibold text-[var(--color-foreground)]">Membresía requerida</p>
        <p class="text-sm text-[var(--color-muted-foreground)] mt-1">Suscríbete para acceder al contenido completo.</p>
      </div>
      <%= link_to "Ver planes", subscription_plans_path,
            class: "inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors whitespace-nowrap" %>
    </div>
  <% end %>

  <% if @posts.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @posts.each do |post| %>
        <%= link_to member_post_path(post.to_param),
              class: "group block bg-white rounded-xl border border-[var(--color-border)] overflow-hidden hover:shadow-md hover:border-[var(--color-primary)]/30 transition-all" do %>
          <div class="aspect-[16/10] bg-[var(--color-muted)] overflow-hidden">
            <% if post.cover_image.attached? %>
              <%= image_tag post.cover_image.variant(resize_to_fill: [ 800, 500 ]),
                    class: "h-full w-full object-cover group-hover:scale-105 transition-transform" %>
            <% else %>
              <div class="h-full w-full flex items-center justify-center text-[var(--color-muted-foreground)] text-sm">Sin imagen</div>
            <% end %>
          </div>
          <div class="p-5">
            <p class="text-xs text-[var(--color-muted-foreground)] uppercase tracking-wider"><%= l(post.published_at.to_date, format: "%d %b %Y") %></p>
            <h3 class="mt-1 font-semibold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors"><%= post.title %></h3>
            <% if post.excerpt.present? %>
              <p class="mt-2 text-sm text-[var(--color-muted-foreground)] line-clamp-3"><%= post.excerpt %></p>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-12 text-center">
      <p class="text-[var(--color-muted-foreground)]">Aún no hay contenido publicado.</p>
    </div>
  <% end %>
</div>
