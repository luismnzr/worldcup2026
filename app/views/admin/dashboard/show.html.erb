<% content_for(:page_title) { "Panel" } %>

<!-- Stats cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-6 sm:mb-8">
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-medium text-[var(--color-muted-foreground)] truncate">Total de Alumnos</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @total_students %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-medium text-[var(--color-muted-foreground)] truncate">Suscripciones Activas</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @active_subscriptions %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center flex-shrink-0">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-medium text-[var(--color-muted-foreground)] truncate">Pedidos Este Mes</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @orders_this_month %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-amber-50 flex items-center justify-center flex-shrink-0">
        <svg class="h-5 w-5 text-[var(--color-warning)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-medium text-[var(--color-muted-foreground)] truncate">Ingresos Este Mes</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= number_to_currency(@revenue_this_month) %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-emerald-50 flex items-center justify-center flex-shrink-0">
        <svg class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-6">
  <!-- Upcoming events -->
  <div class="bg-white rounded-xl border border-[var(--color-border)]">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)] truncate">Próximos Eventos</h2>
      <%= link_to "Ver todos", admin_events_path, class: "text-sm text-[var(--color-primary)] font-medium hover:text-[var(--color-primary-hover)] flex-shrink-0" %>
    </div>
    <% if @upcoming_events.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @upcoming_events.each do |event| %>
          <div class="flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-3 sm:py-3.5">
            <div class="flex-shrink-0 text-center w-12">
              <p class="text-xs text-[var(--color-muted-foreground)] uppercase"><%= event.date.strftime("%b") %></p>
              <p class="text-sm font-semibold text-[var(--color-foreground)]"><%= event.date.day %></p>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= event.title %></p>
              <% if event.location.present? %>
                <p class="text-xs text-[var(--color-muted-foreground)] truncate"><%= event.location %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 sm:px-5 py-10 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No hay eventos próximos</p>
      </div>
    <% end %>
  </div>

  <!-- Recent orders -->
  <div class="bg-white rounded-xl border border-[var(--color-border)]">
    <div class="flex items-center justify-between gap-3 px-4 sm:px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)] truncate">Pedidos Recientes</h2>
      <%= link_to "Ver todos", admin_orders_path, class: "text-sm text-[var(--color-primary)] font-medium hover:text-[var(--color-primary-hover)] flex-shrink-0" %>
    </div>
    <% if @recent_orders.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @recent_orders.each do |order| %>
          <div class="flex items-center gap-3 sm:gap-4 px-4 sm:px-5 py-3 sm:py-3.5">
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--color-foreground)] truncate">#<%= order.id %> &middot; <%= order.user&.full_name || "Walk-in" %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]">hace <%= time_ago_in_words(order.created_at) %></p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-sm font-semibold"><%= number_to_currency(order.total) %></p>
              <span class="text-xs text-[var(--color-muted-foreground)] capitalize"><%= order.status %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 sm:px-5 py-10 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay pedidos</p>
      </div>
    <% end %>
  </div>
</div>
