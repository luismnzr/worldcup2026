<%= form_with(model: [:admin, subscription_plan], class: "space-y-5") do |f| %>
  <% if subscription_plan.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
      <ul class="list-disc pl-5 space-y-1"><% subscription_plan.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :interval, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.select :interval, SubscriptionPlan::INTERVALS.map { |key, opts| [opts[:label], key] }, {}, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Subtítulo corto bajo el precio en la página pública.</p>
  </div>
  <div>
    <%= f.label :features, "Lo que incluye", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :features, rows: 5, placeholder: "Clases ilimitadas por mes\nReserva prioritaria\nCancela cuando quieras", class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Un bullet por línea — aparecen como lista en la tarjeta del plan.</p>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :badge_label, "Badge", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.text_field :badge_label, placeholder: "Ej: Ahorra 20%", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Opcional, chip corto sobre la tarjeta.</p>
    </div>
    <div>
      <%= f.label :sort_order, "Orden", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :sort_order, step: 1, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Más bajo aparece primero en la lista.</p>
    </div>
  </div>
  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :featured, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
      <span class="text-sm font-medium text-[var(--color-foreground)]">Destacado <span class="text-[var(--color-muted-foreground)] font-normal">— aparece como "Más popular"</span></span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :active, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
      <span class="text-sm font-medium text-[var(--color-foreground)]">Activo</span>
    </label>
  </div>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", admin_subscription_plans_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
  </div>
<% end %>
