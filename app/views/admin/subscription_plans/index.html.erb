<% content_for(:page_title) { "Planes de Suscripción" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Planes de Suscripción</h2>
  <%= link_to new_admin_subscription_plan_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Agregar Plan
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <div class="overflow-x-auto">
  <table class="w-full divide-y divide-[var(--color-border)]">
    <thead class="bg-[var(--color-muted)]/50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Orden</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Plan</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Precio</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Intervalo</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Estado</th>
        <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--color-border)]">
      <% @subscription_plans.each do |plan| %>
        <tr class="hover:bg-[var(--color-muted)]/30">
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)] font-mono"><%= plan.sort_order %></td>
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-2 flex-wrap">
              <p class="text-sm font-medium text-[var(--color-foreground)]"><%= plan.name %></p>
              <% if plan.featured? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)]">Destacado</span>
              <% end %>
              <% if plan.badge_label.present? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700"><%= plan.badge_label %></span>
              <% end %>
            </div>
            <% if plan.description.present? %>
              <p class="text-xs text-[var(--color-muted-foreground)] truncate max-w-xs"><%= plan.description %></p>
            <% end %>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]"><%= number_to_currency(plan.price) %></td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= plan.interval_label %></td>
          <td class="px-5 py-3.5">
            <% if plan.active? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Activo</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactivo</span>
            <% end %>
          </td>
          <td class="px-5 py-3.5 text-right">
            <div class="flex items-center justify-end gap-2">
              <%= link_to edit_admin_subscription_plan_path(plan), class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium" do %>Editar<% end %>
              <%= button_to admin_subscription_plan_path(plan), method: :delete,
                    data: { turbo_confirm: "¿Estás seguro? Esto #{plan.user_subscriptions.exists? ? 'desactivará' : 'eliminará'} este plan." },
                    class: "text-sm text-[var(--color-destructive)] hover:text-[var(--color-destructive)]/80 font-medium cursor-pointer" do %>
                <%= plan.user_subscriptions.exists? ? "Desactivar" : "Eliminar" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
  <% if @subscription_plans.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay planes de suscripción.</p>
    </div>
  <% end %>
</div>
