<%= form_with(model: [ :admin, product ], class: "space-y-5") do |f| %>
  <% if product.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
      <ul class="list-disc pl-5 space-y-1"><% product.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, "Nombre", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.text_field :name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :slug, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.text_field :slug, placeholder: "se genera automáticamente", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm font-mono lowercase focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">URL pública: /tienda/<span class="font-mono"><%= product.slug.presence || "[slug]" %></span></p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= f.label :kind, "Tipo", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.select :kind, [ [ "Físico", "physical" ], [ "Digital", "digital" ] ], {}, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :sku, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.text_field :sku, placeholder: "opcional", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm font-mono focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :stock_quantity, "Inventario", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :stock_quantity, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div>
      <%= f.label :price, "Precio", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :shipping_cost, "Costo de envío", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :shipping_cost, step: 0.01, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Solo aplica a productos físicos.</p>
    </div>
    <div class="flex items-end pb-1">
      <label class="flex items-center gap-2 text-sm text-[var(--color-foreground)]">
        <%= f.check_box :requires_shipping, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
        Requiere envío
      </label>
    </div>
  </div>

  <div>
    <%= f.label :description, "Descripción", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>

  <div>
    <%= f.label :image, "Imagen", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.file_field :image, accept: "image/*", class: "block w-full text-sm text-[var(--color-muted-foreground)] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[var(--color-primary)]/10 file:text-[var(--color-primary)] hover:file:bg-[var(--color-primary)]/20" %>
    <% if product.image.attached? %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Imagen actual: <%= product.image.filename %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :digital_asset, "Archivo digital (opcional)", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.file_field :digital_asset, class: "block w-full text-sm text-[var(--color-muted-foreground)] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[var(--color-primary)]/10 file:text-[var(--color-primary)] hover:file:bg-[var(--color-primary)]/20" %>
    <% if product.digital_asset.attached? %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Archivo actual: <%= product.digital_asset.filename %></p>
    <% end %>
    <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Para productos digitales. La entrega protegida se agregará en una fase posterior.</p>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
    <%= f.label :active, "Activo", class: "text-sm font-medium text-[var(--color-foreground)]" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", admin_products_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
  </div>
<% end %>
