<% content_for(:page_title) { "Partidos" } %>

<div class="flex items-center justify-between mb-5 gap-3">
  <p class="text-sm text-[var(--color-muted-foreground)]">
    Captura equipos y resultados. La sincronización automática aplica los resultados finales; tú puedes corregir cualquiera a mano.
  </p>
  <% if @sync_enabled %>
    <%= button_to "Sincronizar ahora", sync_admin_matches_path, method: :post,
          class: "flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
  <% else %>
    <span class="flex-shrink-0 text-xs text-[var(--color-muted-foreground)]">Sync API: configura <code class="font-mono">FOOTBALL_DATA_API_TOKEN</code></span>
  <% end %>
</div>

<div class="space-y-8">
  <% Match::STAGES.each do |stage| %>
    <% matches = @matches_by_stage[stage] %>
    <% next unless matches&.any? %>
    <section>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)] mb-3"><%= matches.first.stage_name %></h2>
      <div class="overflow-x-auto rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-[var(--color-border)] text-left text-xs uppercase tracking-wider text-[var(--color-muted-foreground)]">
              <th class="px-3 py-2 w-12">P#</th>
              <th class="px-3 py-2">Partido</th>
              <th class="px-3 py-2">Kickoff</th>
              <th class="px-3 py-2">Estado</th>
              <th class="px-3 py-2 text-right">Acción</th>
            </tr>
          </thead>
          <tbody>
            <% matches.each do |match| %>
              <tr class="border-b border-[var(--color-border)] last:border-0">
                <td class="px-3 py-2.5 text-[var(--color-muted-foreground)]"><%= match.number %></td>
                <td class="px-3 py-2.5 font-medium text-[var(--color-foreground)]">
                  <%= team_label(match.display_home) %> <span class="text-[var(--color-muted-foreground)]">vs</span> <%= team_label(match.display_away) %>
                  <% if match.status == "finished" %>
                    <span class="text-xs text-[var(--color-muted-foreground)]">(<%= match.home_score %>–<%= match.away_score %>, avanza <%= match.advancing_team %>)</span>
                  <% end %>
                </td>
                <td class="px-3 py-2.5 text-xs text-[var(--color-muted-foreground)]">
                  <%= match.kickoff_at&.in_time_zone(StudioSetting.studio_timezone)&.strftime("%d/%m %H:%M") %>
                </td>
                <td class="px-3 py-2.5">
                  <% variant = { "scheduled" => :secondary, "live" => :warning, "finished" => :success }[match.status] %>
                  <%= render Ui::BadgeComponent.new(text: match.status, variant: variant) %>
                </td>
                <td class="px-3 py-2.5 text-right">
                  <%= link_to "Editar", edit_admin_match_path(match), class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
