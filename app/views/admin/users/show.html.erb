<% content_for(:page_title) { @user.full_name } %>

<div class="max-w-4xl">
  <div class="flex items-center justify-between mb-6">
    <%= link_to "&larr; Volver a Usuarios".html_safe, admin_users_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
    <div class="flex items-center gap-2">
      <%= link_to "Editar Usuario", edit_admin_user_path(@user), class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
      <% if policy(@user).destroy? %>
        <%= button_to "Eliminar", admin_user_path(@user), method: :delete,
              data: { turbo_confirm: "¿Eliminar a #{@user.full_name}? Se borrarán también sus pedidos, suscripción y demás datos asociados. Esta acción no se puede deshacer." },
              class: "inline-flex items-center px-4 py-2 text-sm font-medium text-[var(--color-destructive)] bg-transparent border border-[var(--color-destructive)]/40 rounded-lg hover:bg-[var(--color-destructive)]/10 transition-colors cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <% if @user.photo.attached? %>
        <%= render Ui::AvatarComponent.new(name: @user.full_name, src: url_for(@user.photo.variant(resize_to_fill: [128, 128])), size: :xl) %>
      <% else %>
        <div class="h-16 w-16 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center">
          <span class="text-xl font-medium text-[var(--color-primary)]"><%= @user.first_name[0] %><%= @user.last_name[0] %></span>
        </div>
      <% end %>
      <div>
        <h2 class="text-xl font-bold"><%= @user.full_name %></h2>
        <p class="text-[var(--color-muted-foreground)]"><%= @user.email %></p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <p class="text-[var(--color-muted-foreground)]">Rol</p>
        <p class="font-medium"><%= @user.role.titleize %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Estado</p>
        <p class="font-medium"><%= @user.active? ? "Activo" : "Inactivo" %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Teléfono</p>
        <p class="font-medium"><%= @user.phone.presence || "—" %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Registro</p>
        <p class="font-medium"><%= @user.created_at.strftime("%B %d, %Y") %></p>
      </div>
      <% if @user.stripe_customer_id.present? %>
        <div>
          <p class="text-[var(--color-muted-foreground)]">Stripe ID</p>
          <p class="font-medium font-mono text-xs mt-0.5">
            <%= link_to @user.stripe_customer_id, "https://dashboard.stripe.com/customers/#{@user.stripe_customer_id}", target: "_blank", rel: "noopener", class: "text-[var(--color-primary)] hover:underline" %>
          </p>
        </div>
      <% end %>
    </div>

    <% if @user.notes.present? %>
      <div class="mt-4 pt-4 border-t border-[var(--color-border)]">
        <p class="text-sm text-[var(--color-muted-foreground)] mb-1">Notas</p>
        <p class="text-sm text-[var(--color-foreground)] whitespace-pre-line"><%= @user.notes %></p>
      </div>
    <% end %>
  </div>

  <% if @user.student? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
        <p class="text-sm text-[var(--color-muted-foreground)]">Suscripción</p>
        <p class="text-lg font-bold mt-1"><%= @user.active_subscription ? "Activa" : "Ninguna" %></p>
        <% if @user.active_subscription %>
          <p class="text-xs text-[var(--color-muted-foreground)]"><%= @user.active_subscription.subscription_plan.name %> — vence <%= @user.active_subscription.current_period_end&.strftime("%b %d, %Y") %></p>
        <% end %>
      </div>
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
        <p class="text-sm text-[var(--color-muted-foreground)]">Pedidos</p>
        <p class="text-lg font-bold mt-1"><%= @user.orders.count %></p>
      </div>
    </div>

    <% if @subscription_plans.any? %>
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
        <h3 class="font-semibold mb-2">Otorgar Suscripción</h3>
        <% if @user.active_subscription %>
          <p class="text-xs text-amber-600 mb-4">El usuario ya tiene una suscripción activa (<%= @user.active_subscription.subscription_plan.name %>). Se reemplazará al otorgar una nueva.</p>
        <% end %>
        <%= form_with url: grant_subscription_admin_user_path(@user), method: :post, data: { turbo: false }, class: "flex items-end gap-3 flex-wrap" do %>
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Plan de suscripción</label>
            <select name="subscription_plan_id" required class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
              <% @subscription_plans.each do |plan| %>
                <option value="<%= plan.id %>"><%= plan.name %> — <%= number_to_currency(plan.price) %>/<%= plan.interval_noun %></option>
              <% end %>
            </select>
          </div>
          <div class="min-w-[160px]">
            <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Fecha fin de periodo</label>
            <input type="date" name="period_end" required class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" />
          </div>
          <div class="min-w-[160px]">
            <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Método de pago</label>
            <select name="payment_method" required class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
              <option value="cash">Efectivo</option>
              <option value="card_in_person">Tarjeta (presencial)</option>
            </select>
          </div>
          <button type="submit" class="h-10 inline-flex items-center px-4 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer">
            Otorgar Suscripción
          </button>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if @payments.any? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="px-5 py-4 border-b border-[var(--color-border)]">
        <h3 class="font-semibold">Historial de Compras</h3>
      </div>
      <div class="divide-y divide-[var(--color-border)]">
        <% @payments.each do |payment| %>
          <div class="flex items-center justify-between px-5 py-3 text-sm">
            <div class="flex items-center gap-3">
              <div>
                <p class="font-medium"><%= payment.description.presence || "Pago" %></p>
                <p class="text-xs text-[var(--color-muted-foreground)]">
                  <%= payment.created_at.strftime("%b %d, %Y") %>
                  &middot; <%= payment.payment_method.to_s.titleize.gsub("_", " ") %>
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-semibold">$<%= number_with_precision(payment.amount, precision: 2) %> <%= payment.currency.upcase %></p>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                           <%= case payment.status
                               when 'succeeded' then 'bg-emerald-50 text-emerald-700'
                               when 'pending'   then 'bg-amber-50 text-amber-700'
                               when 'failed'    then 'bg-red-50 text-red-700'
                               when 'refunded'  then 'bg-gray-100 text-gray-600'
                               end %>">
                <%= payment.status.titleize %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
