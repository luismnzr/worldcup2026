<% unread_count = AdminNotification.unread.count %>
<% recent_notifications = AdminNotification.recent.limit(5) %>

<div class="relative inline-block" data-controller="dropdown">
  <button data-action="click->dropdown#toggle" class="relative p-2 rounded-lg hover:bg-[var(--color-muted)] transition-colors text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]">
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
    </svg>
  </button>
  <% if unread_count > 0 %>
    <span class="absolute top-0 right-0 flex h-4 min-w-[1rem] items-center justify-center rounded-full bg-[var(--color-destructive)] text-[10px] font-bold text-white pointer-events-none" style="padding: 5px;">
      <%= unread_count > 99 ? "99+" : unread_count %>
    </span>
  <% end %>

  <div data-dropdown-target="menu"
       class="hidden absolute right-0 z-50 mt-1 w-80 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-background)] shadow-[var(--shadow-md)]">
    <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--color-border)]">
      <h3 class="text-sm font-semibold text-[var(--color-foreground)]">Notificaciones</h3>
      <% if unread_count > 0 %>
        <span class="inline-flex items-center rounded-full bg-[var(--color-primary)]/10 px-2 py-0.5 text-xs font-medium text-[var(--color-primary)]">
          <%= unread_count %> nueva<%= "s" if unread_count > 1 %>
        </span>
      <% end %>
    </div>

    <% if recent_notifications.any? %>
      <div class="max-h-80 overflow-y-auto divide-y divide-[var(--color-border)]">
        <% recent_notifications.each do |notification| %>
          <%= link_to mark_one_read_admin_notification_path(notification), method: :post, class: "flex items-start gap-3 px-4 py-3 hover:bg-[var(--color-muted)]/50 transition-colors #{'bg-[var(--color-primary)]/[0.03]' unless notification.read?}" do %>
            <div class="flex-shrink-0 mt-0.5">
              <%= render_notification_icon(notification.category) %>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-[var(--color-foreground)] <%= 'font-semibold' unless notification.read? %>"><%= notification.title %></p>
              <% if notification.body.present? %>
                <p class="text-xs text-[var(--color-muted-foreground)] truncate"><%= notification.body %></p>
              <% end %>
              <p class="text-xs text-[var(--color-muted-foreground)]/60 mt-0.5"><%= time_ago_in_words(notification.created_at) %></p>
            </div>
            <% unless notification.read? %>
              <span class="flex-shrink-0 mt-1.5 h-2 w-2 rounded-full bg-[var(--color-primary)]"></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-4 py-8 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No hay notificaciones</p>
      </div>
    <% end %>

    <div class="border-t border-[var(--color-border)]">
      <%= link_to admin_notifications_path, class: "block px-4 py-2.5 text-center text-sm font-medium text-[var(--color-primary)] hover:bg-[var(--color-muted)]/50 transition-colors rounded-b-[var(--radius-lg)]" do %>
        Ver todas las notificaciones
      <% end %>
    </div>
  </div>
</div>
