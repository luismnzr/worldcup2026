<% content_for(:title, "Notificaciones") %>
<% content_for(:page_title, "Notificaciones") %>

<div class="max-w-3xl mx-auto space-y-4">
  <div class="flex items-center justify-between">
    <p class="text-sm text-[var(--color-muted-foreground)]">
      <%= @unread_count %> sin leer
    </p>
    <% if @unread_count > 0 %>
      <%= button_to "Marcar todas como leídas", mark_as_read_admin_notifications_path, method: :post, class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium rounded-[var(--radius-md)] border border-[var(--color-border)] text-[var(--color-muted-foreground)] hover:bg-[var(--color-muted)] transition-colors" %>
    <% end %>
  </div>

  <% if @notifications.any? %>
    <div class="bg-white rounded-[var(--radius-lg)] border border-[var(--color-border)] divide-y divide-[var(--color-border)] shadow-[var(--shadow-sm)]">
      <% @notifications.each do |notification| %>
        <%= link_to mark_one_read_admin_notification_path(notification), method: :post, class: "flex items-start gap-3 px-4 py-3 hover:bg-[var(--color-muted)]/50 transition-colors #{'bg-[var(--color-primary)]/[0.03]' unless notification.read?}" do %>
          <div class="flex-shrink-0 mt-0.5">
            <%= render_notification_icon(notification.category) %>
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium text-[var(--color-foreground)] <%= 'font-semibold' unless notification.read? %>">
                <%= notification.title %>
              </p>
              <% unless notification.read? %>
                <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-primary)]"></span>
              <% end %>
            </div>
            <% if notification.body.present? %>
              <p class="text-sm text-[var(--color-muted-foreground)] truncate"><%= notification.body %></p>
            <% end %>
            <p class="text-xs text-[var(--color-muted-foreground)]/70 mt-0.5"><%= time_ago_in_words(notification.created_at) %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-[var(--radius-lg)] border border-[var(--color-border)] shadow-[var(--shadow-sm)] p-12 text-center">
      <svg class="h-12 w-12 mx-auto text-[var(--color-muted-foreground)]/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
      </svg>
      <p class="text-sm text-[var(--color-muted-foreground)]">No hay notificaciones</p>
    </div>
  <% end %>
</div>
