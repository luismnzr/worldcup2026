<% content_for(:page_title) { "Contenido de Miembros" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Contenido de Miembros</h2>
  <%= link_to new_admin_member_post_path,
        class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nuevo Contenido
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full divide-y divide-[var(--color-border)] text-sm">
      <thead class="bg-[var(--color-muted)]/50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Título</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Estado</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Publicado</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        <% @posts.each do |post| %>
          <tr class="hover:bg-[var(--color-muted)]/30">
            <td class="px-5 py-3.5">
              <p class="font-medium text-[var(--color-foreground)]"><%= post.title %></p>
              <p class="text-xs text-[var(--color-muted-foreground)] font-mono">/miembros/<%= post.slug %></p>
            </td>
            <td class="px-5 py-3.5">
              <% if post.published? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Publicado</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Borrador</span>
              <% end %>
            </td>
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]">
              <%= post.published_at ? l(post.published_at, format: "%d/%m/%Y %H:%M") : "—" %>
            </td>
            <td class="px-5 py-3.5 text-right">
              <%= link_to "Editar", edit_admin_member_post_path(post),
                    class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium mr-3" %>
              <%= button_to "Eliminar", admin_member_post_path(post), method: :delete,
                    data: { turbo_confirm: "¿Eliminar “#{post.title}”?" },
                    class: "inline-flex items-center text-sm text-[var(--color-destructive)] hover:underline cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @posts.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay contenido. Crea el primero para tus miembros.</p>
    </div>
  <% end %>
</div>
