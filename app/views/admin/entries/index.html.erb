<% content_for(:page_title) { "Inscripciones" } %>

<div class="space-y-4">
  <div class="flex items-center gap-3">
    <%= render Ui::CardComponent.new(padding: true) do %>
      <p class="text-xs text-[var(--color-muted-foreground)]">Inscritos (pagados)</p>
      <p class="text-2xl font-bold text-[var(--color-foreground)]"><%= @tournament.participants_count %></p>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-[var(--color-border)] text-left text-xs uppercase tracking-wider text-[var(--color-muted-foreground)]">
          <th class="px-3 py-2">Usuario</th>
          <th class="px-3 py-2">Estado</th>
          <th class="px-3 py-2">Monto</th>
          <th class="px-3 py-2">Pagado</th>
          <th class="px-3 py-2 text-right">Acción</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr class="border-b border-[var(--color-border)] last:border-0">
            <td class="px-3 py-2.5">
              <p class="font-medium text-[var(--color-foreground)]"><%= entry.user.display_name_or_default %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= entry.user.email %></p>
            </td>
            <td class="px-3 py-2.5">
              <%= render Ui::BadgeComponent.new(text: entry.status, variant: (entry.paid? ? :success : :secondary)) %>
            </td>
            <td class="px-3 py-2.5 text-[var(--color-muted-foreground)]"><%= number_to_currency(entry.amount, unit: "$") if entry.amount %></td>
            <td class="px-3 py-2.5 text-xs text-[var(--color-muted-foreground)]"><%= entry.paid_at&.in_time_zone(StudioSetting.studio_timezone)&.strftime("%d/%m %H:%M") %></td>
            <td class="px-3 py-2.5 text-right">
              <%= button_to (entry.paid? ? "Marcar pendiente" : "Marcar pagado"),
                    toggle_paid_admin_entry_path(entry), method: :patch,
                    class: "text-sm font-medium text-[var(--color-primary)] hover:underline",
                    data: { turbo_confirm: "¿Cambiar el estado de pago de #{entry.user.display_name_or_default}?" } %>
            </td>
          </tr>
        <% end %>
        <% if @entries.empty? %>
          <tr><td colspan="5" class="px-3 py-8 text-center text-sm text-[var(--color-muted-foreground)]">Aún no hay inscripciones.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
