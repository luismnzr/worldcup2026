<% content_for(:page_title) { "Códigos de Descuento" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Códigos de Descuento</h2>
  <%= link_to new_admin_promotion_code_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nuevo Código
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-x-auto">
  <table class="w-full min-w-[780px] divide-y divide-[var(--color-border)]">
    <thead class="bg-[var(--color-muted)]/50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Código</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Descuento</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Aplica a</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Usos</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Expira</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Estado</th>
        <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Acciones</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--color-border)]">
      <% @promotion_codes.each do |promo| %>
        <tr class="hover:bg-[var(--color-muted)]/30">
          <td class="px-5 py-3.5">
            <span class="text-sm font-mono font-semibold text-[var(--color-foreground)]"><%= promo.code %></span>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]">
            <%= promo.display_discount %> de descuento
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]">
            <%= promo.applies_to_label %>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]">
            <%= promo.times_redeemed %><%= promo.max_redemptions ? " / #{promo.max_redemptions}" : "" %>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]">
            <% if promo.expires_at.present? %>
              <%= l(promo.expires_at, format: "%-d %b %Y") %>
              <% if promo.expired? %>
                <span class="text-xs text-red-600">(vencido)</span>
              <% end %>
            <% else %>
              Sin expiración
            <% end %>
          </td>
          <td class="px-5 py-3.5">
            <% if promo.usable? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Activo</span>
            <% elsif promo.expired? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Vencido</span>
            <% elsif promo.fully_redeemed? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700">Agotado</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactivo</span>
            <% end %>
          </td>
          <td class="px-5 py-3.5 text-right">
            <%= button_to toggle_admin_promotion_code_path(promo), method: :patch,
                  class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium cursor-pointer" do %>
              <%= promo.active? ? "Desactivar" : "Activar" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @promotion_codes.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay códigos de descuento. Crea tu primer código para ofrecer promociones.</p>
    </div>
  <% end %>
</div>
