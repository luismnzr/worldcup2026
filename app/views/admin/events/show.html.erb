<% content_for(:page_title) { @event.title } %>

<div class="mb-6">
  <%= link_to "&larr; Volver a Eventos".html_safe, admin_events_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2 flex-wrap mb-1">
        <h2 class="text-xl font-bold"><%= @event.title %></h2>
        <% if @event.past? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Pasado</span>
        <% elsif @event.published? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Publicado</span>
        <% else %>
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Borrador</span>
        <% end %>
      </div>
      <p class="text-sm text-[var(--color-muted-foreground)]">
        <%= @event.date.strftime("%A, %d %B %Y") %>
        <% if @event.end_date.present? && @event.end_date != @event.date %>
          — <%= @event.end_date.strftime("%A, %d %B %Y") %>
        <% end %>
        <% if @event.start_time.present? %>
          &middot; <%= @event.start_time.strftime("%l:%M %p").strip %><% if @event.end_time.present? %> — <%= @event.end_time.strftime("%l:%M %p").strip %><% end %>
        <% end %>
        <% if @event.location.present? %>
          &middot; <%= @event.location %>
        <% end %>
      </p>
      <% if @event.description.present? %>
        <p class="text-sm text-[var(--color-foreground)] mt-3 whitespace-pre-line"><%= @event.description %></p>
      <% end %>
    </div>
    <div class="flex items-start gap-4 flex-shrink-0">
      <div class="text-right">
        <p class="text-2xl font-bold">
          <%= @event.confirmed_count %><%= " / #{@event.capacity}" if @event.capacity.present? %>
        </p>
        <p class="text-xs text-[var(--color-muted-foreground)]">
          <% if @event.capacity.present? %>
            <%= @event.spots_remaining.to_i %> lugares disponibles
          <% else %>
            registrados
          <% end %>
        </p>
        <p class="text-xs text-[var(--color-muted-foreground)] mt-1">
          <%= @event.free? ? "Gratis" : number_to_currency(@event.price) %>
        </p>
      </div>
      <%= link_to edit_admin_event_path(@event), class: "inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-[var(--color-primary)] border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
    </div>
  </div>
</div>

<% unless @event.full? || @event.past? %>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <h3 class="text-sm font-semibold mb-4">Registrar Persona</h3>
    <%= form_with url: admin_event_event_registrations_path(@event), method: :post, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <%= f.select :user_id,
            @available_users.map { |u| ["#{u.full_name} — #{u.email}", u.id] },
            { include_blank: "Selecciona un usuario..." },
            class: "flex-1 h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] bg-white", required: true %>
      <%= f.submit "Registrar", class: "inline-flex items-center justify-center px-4 h-10 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <% end %>
  </div>
<% end %>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <div class="px-5 py-3 border-b border-[var(--color-border)]">
    <h3 class="text-sm font-semibold">Registros (<%= @registrations.size %>)</h3>
  </div>
  <% if @registrations.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-[var(--color-muted)]/50">
          <tr>
            <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Persona</th>
            <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Email</th>
            <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Registrado</th>
            <th class="px-5 py-3 text-right font-medium text-[var(--color-muted-foreground)]">Acciones</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--color-border)]">
          <% @registrations.each do |registration| %>
            <tr class="hover:bg-[var(--color-muted)]/30">
              <td class="px-5 py-3.5 font-medium">
                <%= link_to registration.user.full_name, admin_user_path(registration.user), class: "hover:underline text-[var(--color-primary)]" %>
              </td>
              <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= registration.user.email %></td>
              <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= registration.created_at.strftime("%b %d, %l:%M %p") %></td>
              <td class="px-5 py-3.5 text-right">
                <%= button_to "Cancelar", admin_event_event_registration_path(@event, registration),
                      method: :delete,
                      data: { turbo_confirm: "¿Cancelar el registro de #{registration.user.full_name}?" },
                      class: "text-red-600 hover:underline text-sm font-medium cursor-pointer" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay registros para este evento.</p>
    </div>
  <% end %>
</div>
