<% content_for(:page_title) { "Eventos" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Eventos</h2>
  <%= link_to new_admin_event_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nuevo Evento
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full divide-y divide-[var(--color-border)]">
      <thead class="bg-[var(--color-muted)]/50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Evento</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Fecha</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Precio</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Registros</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Estado</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Acciones</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        <% @events.each do |event| %>
          <tr class="hover:bg-[var(--color-muted)]/30">
            <td class="px-5 py-3.5">
              <%= link_to event.title, admin_event_path(event), class: "text-sm font-medium text-[var(--color-primary)] hover:underline" %>
              <% if event.location.present? %>
                <p class="text-xs text-[var(--color-muted-foreground)]"><%= event.location %></p>
              <% end %>
            </td>
            <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]">
              <%= l(event.date, format: :long) rescue event.date.strftime("%d %b %Y") %>
              <% if event.end_date.present? && event.end_date != event.date %>
                <p class="text-xs text-[var(--color-muted-foreground)]">hasta <%= l(event.end_date, format: :long) rescue event.end_date.strftime("%d %b %Y") %></p>
              <% end %>
            </td>
            <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]">
              <% if event.free? %>
                <span class="text-[var(--color-muted-foreground)]">Gratis</span>
              <% else %>
                <%= number_to_currency(event.price) %>
              <% end %>
            </td>
            <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]">
              <%= event.confirmed_count %><%= " / #{event.capacity}" if event.capacity.present? %>
            </td>
            <td class="px-5 py-3.5">
              <% if event.past? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Pasado</span>
              <% elsif event.published? %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Publicado</span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Borrador</span>
              <% end %>
            </td>
            <td class="px-5 py-3.5 text-right">
              <div class="flex items-center justify-end gap-2">
                <%= link_to "Editar", edit_admin_event_path(event), class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium" %>
                <%= button_to admin_event_path(event), method: :delete,
                      data: { turbo_confirm: "¿Eliminar este evento? Se cancelarán todos los registros." },
                      class: "text-sm text-[var(--color-destructive)] hover:text-[var(--color-destructive)]/80 font-medium cursor-pointer" do %>
                  Eliminar
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @events.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay eventos. Crea tu primer evento para empezar.</p>
    </div>
  <% end %>
</div>

<% if defined?(@pagy) && @pagy.pages > 1 %>
  <div class="mt-4 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
