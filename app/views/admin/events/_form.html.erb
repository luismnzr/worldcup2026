<%= form_with(model: [:admin, event], class: "space-y-5", multipart: true) do |f| %>
  <% if event.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
      <ul class="list-disc pl-5 space-y-1"><% event.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :title, "Título", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :title, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div>
    <%= f.label :description, "Descripción", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :date, "Fecha de inicio", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.date_field :date, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :end_date, "Fecha de fin (opcional)", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.date_field :end_date, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :start_time, "Hora de inicio", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.time_field :start_time, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :end_time, "Hora de fin", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.time_field :end_time, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>
  <div>
    <%= f.label :location, "Ubicación", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :location, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :capacity, "Capacidad (opcional)", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :capacity, min: 1, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Deja vacío si no hay cupo límite.</p>
    </div>
    <div>
      <%= f.label :price, "Precio (opcional)", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Deja vacío para un evento gratuito.</p>
    </div>
  </div>
  <div>
    <%= f.label :cover_image, "Imagen de portada", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <% if event.cover_image.attached? %>
      <div class="mb-2">
        <%= image_tag event.cover_image, class: "h-32 rounded-lg border border-[var(--color-border)]" %>
      </div>
    <% end %>
    <%= f.file_field :cover_image, accept: "image/*", class: "block w-full text-sm text-[var(--color-muted-foreground)] file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[var(--color-muted)] file:text-[var(--color-foreground)] hover:file:bg-[var(--color-muted)]/70 cursor-pointer" %>
  </div>
  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :published, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
      <span class="text-sm font-medium text-[var(--color-foreground)]">Publicado <span class="text-[var(--color-muted-foreground)] font-normal">— visible al público</span></span>
    </label>
    <label class="flex items-center gap-2 cursor-pointer">
      <%= f.check_box :in_person_payment_only, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
      <span class="text-sm font-medium text-[var(--color-foreground)]">Pago presencial únicamente</span>
    </label>
  </div>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <%= link_to "Cancelar", admin_events_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
  </div>
<% end %>
