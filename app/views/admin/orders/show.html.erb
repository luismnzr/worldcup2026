<% content_for(:page_title) { "Pedido ##{@order.id}" } %>
<div class="max-w-4xl">
  <%= link_to "&larr; Volver a Pedidos".html_safe, admin_orders_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] mb-4 inline-block" %>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold">Pedido #<%= @order.id %></h2>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium
                    <%= case @order.status
                        when 'completed' then 'bg-emerald-50 text-emerald-700'
                        when 'pending' then 'bg-amber-50 text-amber-700'
                        when 'cancelled' then 'bg-red-50 text-red-700'
                        end %>">
          <%= @order.status.titleize %>
        </span>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium
                    <%= case @order.shipping_status
                        when 'unfulfilled' then 'bg-gray-100 text-gray-700'
                        when 'fulfilled'   then 'bg-blue-50 text-blue-700'
                        when 'shipped'     then 'bg-violet-50 text-violet-700'
                        when 'delivered'   then 'bg-emerald-50 text-emerald-700'
                        end %>">
          <%= @order.shipping_status.titleize %>
        </span>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm mb-6">
      <div>
        <p class="text-[var(--color-muted-foreground)]">Cliente</p>
        <p class="font-medium"><%= @order.user&.full_name || @order.shipping_name.presence || "Sin registro" %></p>
        <% if @order.email.present? %>
          <p class="text-xs text-[var(--color-muted-foreground)]"><%= @order.email %></p>
        <% end %>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Método de Pago</p>
        <p class="font-medium"><%= @order.payment_method.titleize %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Fecha</p>
        <p class="font-medium"><%= @order.created_at.strftime("%B %d, %Y %l:%M %p") %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Total</p>
        <p class="text-lg font-bold"><%= number_to_currency(@order.total) %></p>
      </div>
    </div>

    <% if @order.notes.present? %>
      <div class="text-sm mb-6">
        <p class="text-[var(--color-muted-foreground)]">Notas</p>
        <p class="mt-1"><%= @order.notes %></p>
      </div>
    <% end %>
  </div>

  <% if @order.shipping_address_lines.any? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
      <h3 class="font-semibold mb-3 text-sm">Dirección de envío</h3>
      <div class="text-sm text-[var(--color-foreground)] space-y-0.5">
        <% @order.shipping_address_lines.each do |line| %>
          <p><%= line %></p>
        <% end %>
        <% if @order.phone.present? %>
          <p class="text-[var(--color-muted-foreground)] mt-2">Tel: <%= @order.phone %></p>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @order.requires_shipping? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
      <h3 class="font-semibold mb-3 text-sm">Cumplimiento</h3>
      <%= form_with model: [ :admin, @order ], method: :patch, class: "flex flex-wrap items-end gap-3" do |f| %>
        <div class="min-w-[180px]">
          <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Estado</label>
          <%= f.select :shipping_status,
                Order::SHIPPING_STATUSES.map { |s| [ s.titleize, s ] },
                {},
                class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
        </div>
        <div class="flex-1 min-w-[180px]">
          <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Número de guía</label>
          <%= f.text_field :tracking_number, placeholder: "ABC123456", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm font-mono focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
        </div>
        <%= f.submit "Actualizar envío", class: "h-10 inline-flex items-center px-4 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
    <div class="px-5 py-4 border-b border-[var(--color-border)]">
      <h3 class="font-semibold">Artículos</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full divide-y divide-[var(--color-border)]">
        <thead class="bg-[var(--color-muted)]/50">
          <tr>
            <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Producto</th>
            <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Precio Unitario</th>
            <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Cant.</th>
            <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Subtotal</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--color-border)]">
          <% @order.order_items.each do |item| %>
            <tr>
              <td class="px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)]"><%= item.product.name %></td>
              <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= number_to_currency(item.unit_price) %></td>
              <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= item.quantity %></td>
              <td class="px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] text-right"><%= number_to_currency(item.quantity * item.unit_price) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot class="bg-[var(--color-muted)]/30 text-sm">
          <tr>
            <td colspan="3" class="px-5 py-2 text-right text-[var(--color-muted-foreground)]">Subtotal</td>
            <td class="px-5 py-2 text-right"><%= number_to_currency(@order.subtotal) %></td>
          </tr>
          <% if @order.shipping_cost.to_d.positive? %>
            <tr>
              <td colspan="3" class="px-5 py-2 text-right text-[var(--color-muted-foreground)]">Envío</td>
              <td class="px-5 py-2 text-right"><%= number_to_currency(@order.shipping_cost) %></td>
            </tr>
          <% end %>
          <% if @order.discount_total.to_d.positive? %>
            <tr>
              <td colspan="3" class="px-5 py-2 text-right text-[var(--color-muted-foreground)]">Descuento</td>
              <td class="px-5 py-2 text-right text-emerald-700">−<%= number_to_currency(@order.discount_total) %></td>
            </tr>
          <% end %>
          <tr class="border-t border-[var(--color-border)]">
            <td colspan="3" class="px-5 py-3 text-right font-semibold">Total</td>
            <td class="px-5 py-3 text-right font-bold"><%= number_to_currency(@order.total) %></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>
