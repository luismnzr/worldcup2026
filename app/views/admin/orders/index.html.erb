<% content_for(:page_title) { "Pedidos" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Pedidos</h2>
  <%= link_to new_admin_order_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Nuevo Pedido
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <div class="overflow-x-auto">
  <table class="w-full divide-y divide-[var(--color-border)]">
    <thead class="bg-[var(--color-muted)]/50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Pedido</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Cliente</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Artículos</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Total</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Pago</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Estado</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Fecha</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--color-border)]">
      <% @orders.each do |order| %>
        <tr class="hover:bg-[var(--color-muted)]/30">
          <td class="px-5 py-3.5 text-sm">
            <%= link_to "##{order.id}", admin_order_path(order), class: "font-medium text-[var(--color-foreground)] hover:text-[var(--color-primary)] hover:underline" %>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]"><%= order.user&.full_name || "Sin registro" %></td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= order.order_items.sum(:quantity) %> artículos</td>
          <td class="px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)]"><%= number_to_currency(order.total) %></td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= order.payment_method.titleize %></td>
          <td class="px-5 py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                        <%= case order.status; when 'completed' then 'bg-emerald-50 text-emerald-700'; when 'pending' then 'bg-amber-50 text-amber-700'; when 'cancelled' then 'bg-red-50 text-red-700'; end %>">
              <%= order.status.titleize %>
            </span>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= order.created_at.strftime("%b %d, %Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
  <% if @orders.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">Aún no hay pedidos.</p>
    </div>
  <% end %>
</div>
