<% content_for(:title) { @product.name } %>

<div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
  <%= link_to "&larr; Volver a la tienda".html_safe, products_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] mb-6 inline-block" %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
    <div class="aspect-square bg-[var(--color-muted)] rounded-xl overflow-hidden">
      <% if @product.image.attached? %>
        <%= image_tag @product.image.variant(resize_to_limit: [1000, 1000]), class: "h-full w-full object-cover" %>
      <% else %>
        <div class="h-full w-full flex items-center justify-center text-[var(--color-muted-foreground)]">Sin imagen</div>
      <% end %>
    </div>

    <div>
      <h1 class="text-3xl font-bold text-[var(--color-foreground)]"><%= @product.name %></h1>
      <p class="mt-3 text-2xl font-bold text-[var(--color-foreground)]"><%= number_to_currency(@product.price) %></p>

      <% if @product.description.present? %>
        <div class="mt-6 text-[var(--color-muted-foreground)] whitespace-pre-line"><%= @product.description %></div>
      <% end %>

      <div class="mt-8">
        <% if @product.stock_quantity.positive? %>
          <p class="text-sm text-[var(--color-muted-foreground)] mb-3">
            <%= @product.stock_quantity %> en stock
            <% if @product.physical? && @product.shipping_cost.to_d.positive? %>
              &middot; Envío <%= number_to_currency(@product.shipping_cost) %>
            <% elsif @product.digital? %>
              &middot; Producto digital
            <% end %>
          </p>
          <% if user_signed_in? %>
            <%= button_to checkout_product_path(product_id: @product.to_param), method: :post,
                  class: "w-full inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" do %>
              Comprar
            <% end %>
          <% else %>
            <%= link_to "Iniciar sesión para comprar", new_user_session_path,
                  class: "w-full inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
          <% end %>
        <% else %>
          <p class="text-sm text-red-600">Agotado</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
