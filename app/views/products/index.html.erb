<% content_for(:title) { "Tienda" } %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--color-foreground)]">Tienda</h1>
    <p class="text-[var(--color-muted-foreground)] mt-2">Productos disponibles en stock.</p>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @products.each do |product| %>
        <%= link_to product_path(product.to_param), class: "group block bg-white rounded-xl border border-[var(--color-border)] overflow-hidden hover:shadow-md hover:border-[var(--color-primary)]/30 transition-all" do %>
          <div class="aspect-square bg-[var(--color-muted)] overflow-hidden">
            <% if product.image.attached? %>
              <%= image_tag product.image.variant(resize_to_fill: [600, 600]), class: "h-full w-full object-cover group-hover:scale-105 transition-transform" %>
            <% else %>
              <div class="h-full w-full flex items-center justify-center text-[var(--color-muted-foreground)] text-sm">Sin imagen</div>
            <% end %>
          </div>
          <div class="p-5">
            <h3 class="font-semibold text-[var(--color-foreground)] group-hover:text-[var(--color-primary)] transition-colors"><%= product.name %></h3>
            <p class="mt-1 text-lg font-bold text-[var(--color-foreground)]"><%= number_to_currency(product.price) %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-12 text-center">
      <p class="text-[var(--color-muted-foreground)]">Aún no hay productos en la tienda.</p>
    </div>
  <% end %>
</div>
