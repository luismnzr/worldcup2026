<% content_for(:title) { "Crear Cuenta" } %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-sm">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-[var(--color-foreground)]">Crea tu cuenta</h1>
        <p class="text-[var(--color-muted-foreground)] mt-2 text-sm">¿Ya tienes cuenta? <%= link_to "Iniciar sesión", new_user_session_path, class: "font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <% if resource.errors.any? %>
          <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200">
            <p class="text-sm font-medium text-red-700">Por favor corrige los siguientes errores:</p>
            <ul class="mt-1 text-sm text-red-600 list-disc list-inside">
              <% resource.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-4">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label for="user_first_name" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Nombre</label>
              <%= f.text_field :first_name, placeholder: "Jane", required: true, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
            </div>
            <div>
              <label for="user_last_name" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Apellido</label>
              <%= f.text_field :last_name, placeholder: "Doe", required: true, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
            </div>
          </div>

          <div>
            <label for="user_display_name" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Apodo <span class="text-[var(--color-muted-foreground)] font-normal">(opcional, sale en la tabla)</span></label>
            <%= f.text_field :display_name, placeholder: "El Crack", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div>
            <label for="user_email" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Correo electrónico</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@ejemplo.com", required: true, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div>
            <label for="user_password" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Contraseña</label>
            <%= f.password_field :password, autocomplete: "new-password", placeholder: "Al menos 6 caracteres", required: true, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
            <p class="mt-1 text-xs text-[var(--color-muted-foreground)]">Debe tener al menos 6 caracteres</p>
          </div>

          <div>
            <label for="user_password_confirmation" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Confirmar contraseña</label>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repite tu contraseña", required: true, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <button type="submit" class="w-full h-10 flex items-center justify-center text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm">
            Crear cuenta
          </button>

          <p class="text-xs text-center text-[var(--color-muted-foreground)]">
            Al registrarte, aceptas nuestros <%= link_to "Términos de Servicio", terms_path, class: "underline hover:text-[var(--color-foreground)]" %>
          </p>
        </div>
      <% end %>
  </div>
</div>
