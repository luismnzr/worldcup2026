<% content_for(:title) { "Iniciar Sesión" } %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center px-4 sm:px-6 lg:px-8">
  <div class="w-full max-w-sm">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-[var(--color-foreground)]">Inicia sesión en tu cuenta</h1>
        <p class="text-[var(--color-muted-foreground)] mt-2 text-sm">¿No tienes cuenta? <%= link_to "Comienza gratis", new_user_registration_path, class: "font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <% if alert.present? %>
          <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= alert %></div>
        <% end %>

        <div class="space-y-4">
          <div>
            <label for="user_email" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Correo electrónico</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@ejemplo.com", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="user_password" class="block text-sm font-medium text-[var(--color-foreground)]">Contraseña</label>
              <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-xs text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Ingresa tu contraseña", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
            <label for="user_remember_me" class="ml-2 text-sm text-[var(--color-muted-foreground)]">Recuérdame por 30 días</label>
          </div>

          <button type="submit" class="w-full h-10 flex items-center justify-center text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm">
            Iniciar sesión
          </button>
        </div>
      <% end %>
  </div>
</div>
