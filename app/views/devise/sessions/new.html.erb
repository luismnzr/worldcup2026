<% content_for(:title) { "Iniciar Sesión" } %>

<div class="flex min-h-[calc(100vh-4rem)]">
  <!-- Left panel: gradient brand -->
  <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--color-primary)] via-[var(--color-accent)] to-[var(--color-primary)]"></div>
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wNSI+PGNpcmNsZSBjeD0iMzAiIGN5PSIzMCIgcj0iMSIvPjwvZz48L2c+PC9zdmc+')] opacity-40"></div>
    <div class="relative flex flex-col justify-center px-12 lg:px-16">
      <div class="flex items-center gap-2 mb-8">
        <div class="h-10 w-10 rounded-lg bg-white/20 flex items-center justify-center">
          <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <span class="text-2xl font-bold text-white"><%= StudioSetting.get("studio_name") %></span>
      </div>
      <h2 class="text-3xl font-bold text-white">Bienvenido de vuelta a<br>tu práctica</h2>
      <p class="mt-4 text-white/70 max-w-sm">Inicia sesión para reservar clases, administrar tu cuenta y continuar tu camino de bienestar.</p>
      <div class="mt-12 space-y-4">
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white/10 flex items-center justify-center"><svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <span class="text-sm text-white/80">Reserva y administra tus clases</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white/10 flex items-center justify-center"><svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <span class="text-sm text-white/80">Rastrea tu progreso e historial</span>
        </div>
        <div class="flex items-center gap-3">
          <div class="h-8 w-8 rounded-full bg-white/10 flex items-center justify-center"><svg class="h-4 w-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></div>
          <span class="text-sm text-white/80">Administra paquetes y facturación</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Right panel: form -->
  <div class="flex flex-1 items-center justify-center px-4 sm:px-6 lg:px-8">
    <div class="w-full max-w-sm">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-[var(--color-foreground)]">Inicia sesión en tu cuenta</h1>
        <p class="text-[var(--color-muted-foreground)] mt-2 text-sm">¿No tienes cuenta? <%= link_to "Comienza gratis", new_user_registration_path, class: "font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <% if alert.present? %>
          <div class="mb-4 p-3 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700"><%= alert %></div>
        <% end %>

        <div class="space-y-4">
          <div>
            <label for="user_email" class="block text-sm font-medium text-[var(--color-foreground)] mb-1.5">Correo electrónico</label>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "tu@ejemplo.com", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="user_password" class="block text-sm font-medium text-[var(--color-foreground)]">Contraseña</label>
              <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name), class: "text-xs text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %>
            </div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "Ingresa tu contraseña", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] bg-white text-sm placeholder:text-[var(--color-muted-foreground)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition" %>
          </div>

          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
            <label for="user_remember_me" class="ml-2 text-sm text-[var(--color-muted-foreground)]">Recuérdame por 30 días</label>
          </div>

          <button type="submit" class="w-full h-10 flex items-center justify-center text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm">
            Iniciar sesión
          </button>
        </div>
      <% end %>
    </div>
  </div>
</div>
