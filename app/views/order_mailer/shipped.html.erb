<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Tu pedido está en camino</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">El pedido <strong>#<%= @order.id %></strong> fue enviado.</p>

<% if @tracking_number.present? %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
    <tr>
      <td style="padding: 20px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
          <%= email_detail_row("Número de guía", @tracking_number) %>
        </table>
      </td>
    </tr>
  </table>
<% end %>

<%= email_button("Ver mi pedido", profile_url) %>
