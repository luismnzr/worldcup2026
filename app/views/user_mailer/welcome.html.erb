<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Bienvenido a <%= studio_name %>!</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hola <%= @user.first_name %>, gracias por unirte. Te dejamos algunos puntos de partida.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <tr>
    <td style="padding: 16px 20px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding: 8px 0;">
            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background-color: #6366f1; color: #ffffff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 600; margin-right: 12px; vertical-align: middle;">1</span>
            <span style="font-size: 14px; color: #0f172a; font-weight: 500; vertical-align: middle;">Explora la tienda y los próximos eventos</span>
          </td>
        </tr>
        <tr>
          <td style="padding: 8px 0;">
            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background-color: #6366f1; color: #ffffff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 600; margin-right: 12px; vertical-align: middle;">2</span>
            <span style="font-size: 14px; color: #0f172a; font-weight: 500; vertical-align: middle;">Suscríbete para acceso completo</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<%= email_button("Ver Tienda", products_url) %>
