<% content_for(:title) { "Tabla de posiciones" } %>

<div class="mx-auto max-w-2xl px-4 sm:px-6 py-6 sm:py-10 space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-[var(--color-foreground)]"><%= current_tournament.name %></h1>
    <p class="text-sm text-[var(--color-muted-foreground)] mt-1">Tabla de posiciones en vivo</p>
  </div>

  <%= render "shared/prize_banner", tournament: current_tournament, participants_count: @participants_count %>

  <%= turbo_stream_from "leaderboard" %>
  <%= render "leaderboard/table", rankings: @rankings, tournament: current_tournament, highlight_user: (current_user if user_signed_in?) %>

  <% unless user_signed_in? && current_entry&.paid? %>
    <div class="text-center">
      <%= link_to "Inscríbete para jugar", new_entry_path, class: "inline-flex items-center px-5 py-2.5 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
    </div>
  <% end %>
</div>
