<div id="leaderboard">
  <% if rankings.empty? %>
    <%= render Ui::CardComponent.new do %>
      <p class="text-center text-sm text-[var(--color-muted-foreground)] py-8">
        Aún no hay jugadores inscritos. ¡Sé el primero en entrar!
      </p>
    <% end %>
  <% else %>
    <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-background)] shadow-[var(--shadow-sm)]">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-[var(--color-border)] text-left text-xs uppercase tracking-wider text-[var(--color-muted-foreground)]">
            <th class="px-3 py-3 w-10">#</th>
            <th class="px-3 py-3">Jugador</th>
            <th class="px-3 py-3 text-right">Pts</th>
            <th class="px-3 py-3 text-right hidden sm:table-cell">Aciertos</th>
            <th class="px-3 py-3 text-right hidden sm:table-cell">% </th>
          </tr>
        </thead>
        <tbody>
          <% highlight_user = local_assigns[:highlight_user] %>
          <% rankings.each_with_index do |row, i| %>
            <tr class="border-b border-[var(--color-border)] last:border-0 <%= "bg-[var(--color-primary)]/5" if highlight_user && row.user == highlight_user %>">
              <td class="px-3 py-3 font-semibold text-[var(--color-muted-foreground)]">
                <% if i.zero? %>🥇<% elsif i == 1 %>🥈<% elsif i == 2 %>🥉<% else %><%= i + 1 %><% end %>
              </td>
              <td class="px-3 py-3 font-medium text-[var(--color-foreground)]">
                <%= row.user.display_name_or_default %>
              </td>
              <td class="px-3 py-3 text-right font-bold text-[var(--color-primary)]"><%= row.points %></td>
              <td class="px-3 py-3 text-right text-[var(--color-muted-foreground)] hidden sm:table-cell"><%= row.correct_count %>/<%= row.graded_count %></td>
              <td class="px-3 py-3 text-right text-[var(--color-muted-foreground)] hidden sm:table-cell"><%= row.accuracy %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
