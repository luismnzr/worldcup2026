<%# Premio simbólico + contador de inscritos. NUNCA muestra montos como premio. %>
<div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5 sm:p-6">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">🏆 Premio</p>
      <p class="mt-1 text-sm sm:text-base font-medium text-[var(--color-foreground)]">
        <%= tournament.prize_description.presence || "TBD" %>
      </p>
    </div>
    <div class="text-right flex-shrink-0">
      <p class="text-2xl sm:text-3xl font-bold text-[var(--color-foreground)]"><%= participants_count %></p>
      <p class="text-xs text-[var(--color-muted-foreground)]">inscritos</p>
    </div>
  </div>
</div>
