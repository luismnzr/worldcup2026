<footer class="bg-[var(--color-footer)] text-[var(--color-footer-foreground)]" data-theme-static>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-3 gap-8 py-12 lg:py-16">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <%= brand_mark(box: "h-8 w-8", emoji: "text-xl") %>
          <span class="text-lg font-bold"><%= StudioSetting.get("studio_name") %></span>
        </div>
        <p class="text-sm text-gray-400 max-w-xs">28 Junio — 19 Julio</p>
      </div>

      <!-- Menú -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Menú</h4>
        <nav class="space-y-3">
          <%= link_to "Mis Predicciones", predictions_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Leaderboard", leaderboard_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
          <%= link_to "Partidos", bracket_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
        </nav>
      </div>

      <!-- Soporte -->
      <div>
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Soporte</h4>
        <nav class="space-y-3">
          <%= link_to "Términos", terms_path, class: "block text-sm text-gray-300 hover:text-white transition-colors" %>
        </nav>
      </div>
    </div>

    <div class="border-t border-gray-800 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-500">&copy; <%= Date.current.year %> <%= StudioSetting.get("studio_name") %>. Todos los derechos reservados.</p>
      <p class="text-xs text-gray-500">Made by Louie-G using Eclipse</p>
    </div>
  </div>
</footer>
