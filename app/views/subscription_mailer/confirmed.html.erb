<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Suscripción Confirmada</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hola <%= @user.first_name %>, ¡tu suscripción está activa!</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Plan", @plan.name) %>
        <%= email_detail_row("Precio", "#{format_currency(@plan.price)}/#{@plan.interval_noun}") %>
        <% if @subscription.current_period_end.present? %>
          <%= email_detail_row("Próximo Cobro", format_date(@subscription.current_period_end.to_date)) %>
        <% end %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">Tu membresía ya está activa.</p>

<%= email_button("Ir a mi perfil", profile_url) %>
