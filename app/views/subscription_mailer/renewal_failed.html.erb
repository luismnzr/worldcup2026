<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Pago Fallido</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hola <%= @user.first_name %>, no pudimos procesar el pago de tu suscripción.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef2f2; border-radius: 8px; border: 1px solid #fecaca; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Plan", @plan.name) %>
        <%= email_detail_row("Monto", "#{format_currency(@plan.price)}/#{@plan.interval_noun}") %>
        <%= email_detail_row("Estado", "Pago Fallido") %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">Por favor actualiza tu método de pago para continuar tu suscripción y evitar perder acceso a las clases.</p>

<%= email_button("Actualizar Método de Pago", profile_billing_url, color: "#ef4444") %>
