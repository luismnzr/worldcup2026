<% content_for(:title) { "Membresía" } %>

<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
  <div class="text-center mb-12">
    <h1 class="text-3xl font-bold tracking-tight text-[var(--color-foreground)]">Hazte miembro</h1>
    <p class="text-[var(--color-muted-foreground)] mt-2">Elige el plan que se adapta a ti.</p>
  </div>

  <% if @plans.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @plans.each do |plan| %>
        <div class="bg-white rounded-xl border <%= plan.featured? ? 'border-[var(--color-primary)] ring-2 ring-[var(--color-primary)]/20' : 'border-[var(--color-border)]' %> p-6 flex flex-col">
          <% if plan.badge_label.present? %>
            <span class="inline-flex items-center self-start px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)] mb-2">
              <%= plan.badge_label %>
            </span>
          <% end %>
          <h2 class="text-xl font-bold text-[var(--color-foreground)]"><%= plan.name %></h2>
          <% if plan.description.present? %>
            <p class="mt-2 text-sm text-[var(--color-muted-foreground)]"><%= plan.description %></p>
          <% end %>
          <div class="mt-6">
            <span class="text-4xl font-bold text-[var(--color-foreground)]"><%= number_to_currency(plan.price, precision: 0) %></span>
            <span class="text-sm text-[var(--color-muted-foreground)]"> / <%= plan.interval_noun %></span>
          </div>

          <% if plan.features_list.any? %>
            <ul class="mt-6 space-y-2 text-sm text-[var(--color-muted-foreground)] flex-1">
              <% plan.features_list.each do |feature| %>
                <li class="flex items-start gap-2">
                  <svg class="h-4 w-4 mt-0.5 text-[var(--color-primary)] flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <span><%= feature %></span>
                </li>
              <% end %>
            </ul>
          <% end %>

          <div class="mt-8">
            <% if user_signed_in? %>
              <%= button_to checkout_subscription_path(plan_id: plan.id), method: :post,
                    class: "w-full inline-flex items-center justify-center px-4 py-3 text-sm font-semibold text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" do %>
                Suscribirme
              <% end %>
            <% else %>
              <%= link_to "Iniciar sesión para suscribirme", new_user_session_path,
                    class: "w-full inline-flex items-center justify-center px-4 py-3 text-sm font-semibold text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-12 text-center">
      <p class="text-[var(--color-muted-foreground)]">Aún no hay planes disponibles.</p>
    </div>
  <% end %>
</div>
