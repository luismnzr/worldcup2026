<!DOCTYPE html>
<html lang="es" class="h-full">
  <head>
    <title>Admin — <%= content_for(:title) || StudioSetting.get("studio_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#c3291c">
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var systemDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
          if (stored === "dark" || (!stored && systemDark)) {
            document.documentElement.classList.add("dark");
          }
        } catch (_) {}
      })();
    </script>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-[var(--color-secondary)] text-[var(--color-foreground)]" style="font-family: var(--font-sans);">
    <div class="flex h-full" data-controller="mobile-menu">
      <%# Backdrop — shown on mobile only when the sidebar is open %>
      <div data-mobile-menu-target="backdrop"
           data-action="click->mobile-menu#close"
           class="hidden fixed inset-0 z-40 bg-black/50 lg:hidden"
           aria-hidden="true"></div>

      <%# Sidebar — off-canvas on mobile, permanently visible on desktop %>
      <aside data-mobile-menu-target="menu"
             data-theme-static
             class="admin-sidebar z-50 flex flex-col w-72 max-w-[85%] bg-white border-r border-[var(--color-border)]">
        <div class="flex items-center justify-between gap-2 h-16 px-4 sm:px-5 border-b border-[var(--color-border)]">
          <div class="flex items-center gap-2 min-w-0">
            <%= brand_mark(box: "h-8 w-8 flex-shrink-0", emoji: "text-xl") %>
            <span class="text-lg font-bold text-[var(--color-foreground)] truncate"><%= StudioSetting.get("studio_name") %></span>
          </div>
          <button type="button" class="lg:hidden p-2 -mr-2 rounded-lg hover:bg-[var(--color-muted)] flex-shrink-0" data-action="mobile-menu#close" aria-label="Cerrar menú">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
          <%= admin_nav_link "Panel", admin_dashboard_path, "dashboard" %>
          <div class="pt-4 mt-4 border-t border-[var(--color-border)]">
            <p class="px-3 mb-1 text-xs font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]/60">Quiniela</p>
            <%= admin_nav_link "Partidos", admin_matches_path, "events" %>
            <%= admin_nav_link "Inscripciones", admin_entries_path, "orders" %>
            <%= admin_nav_link "Torneo", edit_admin_tournament_path, "settings" %>
          </div>
          <%= admin_nav_link "Usuarios", admin_users_path, "users" %>
          <%= admin_nav_link "Eventos", admin_events_path, "events" %>
          <%= admin_nav_link "Suscripciones", admin_subscription_plans_path, "subscriptions" %>
          <%= admin_nav_link "Contenido Miembros", admin_member_posts_path, "member_posts" %>
          <%= admin_nav_link "Descuentos", admin_promotion_codes_path, "discounts" %>
          <div class="pt-4 mt-4 border-t border-[var(--color-border)]">
            <p class="px-3 mb-1 text-xs font-semibold uppercase tracking-wider text-[var(--color-muted-foreground)]/60">Tienda</p>
            <%= admin_nav_link "Productos", admin_products_path, "products" %>
            <%= admin_nav_link "Pedidos", admin_orders_path, "orders" %>
          </div>
          <div class="pt-4 mt-4 border-t border-[var(--color-border)]">
            <%= admin_nav_link "Notificaciones", admin_notifications_path, "notifications" %>
            <%= admin_nav_link "Configuración", admin_settings_path, "settings" %>
            <%= admin_nav_link "Reportes", admin_reports_path, "reports" %>
          </div>
        </nav>
        <div class="p-4 border-t border-[var(--color-border)] space-y-3">
          <div class="flex items-center gap-3">
            <div class="h-8 w-8 rounded-full bg-[var(--color-primary)] flex items-center justify-center flex-shrink-0">
              <span class="text-xs font-medium text-white"><%= current_user.first_name[0] %><%= current_user.last_name[0] %></span>
            </div>
            <div class="text-sm min-w-0 flex-1">
              <p class="font-medium truncate text-[var(--color-foreground)]"><%= current_user.full_name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]">Administrador</p>
            </div>
          </div>
          <div class="flex items-center gap-2 lg:hidden">
            <%= link_to root_path, class: "flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-medium rounded-lg border border-[var(--color-border)] text-[var(--color-muted-foreground)] hover:bg-[var(--color-muted)] transition-colors" do %>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              Ver Sitio
            <% end %>
            <%= link_to "Salir", destroy_user_session_path, data: { turbo_method: :delete }, class: "flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 text-xs font-medium rounded-lg border border-[var(--color-border)] text-[var(--color-muted-foreground)] hover:bg-[var(--color-muted)] transition-colors" %>
          </div>
        </div>
      </aside>

      <%# Main content %>
      <div class="flex flex-col flex-1 min-w-0 lg:pl-64">
        <header class="sticky top-0 z-30 flex items-center justify-between h-14 sm:h-16 px-4 sm:px-6 gap-3 border-b border-[var(--color-border)] bg-[var(--color-background)]/80 backdrop-blur-lg" data-controller="theme">
          <div class="flex items-center gap-2 sm:gap-4 min-w-0">
            <button type="button" class="lg:hidden p-2 -ml-2 rounded-lg hover:bg-[var(--color-muted)] flex-shrink-0" data-action="mobile-menu#toggle" aria-label="Abrir menú">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
            </button>
            <h1 class="text-base sm:text-lg font-semibold text-[var(--color-foreground)] truncate"><%= yield :page_title %></h1>
          </div>
          <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
            <%= render "shared/theme_toggle" %>
            <%= render "admin/notifications/bell" %>
            <%= link_to root_path, class: "hidden sm:inline-flex items-center gap-1.5 text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors" do %>
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              Ver Sitio
            <% end %>
            <%= link_to "Cerrar sesión", destroy_user_session_path, data: { turbo_method: :delete }, class: "hidden sm:inline text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] transition-colors" %>
          </div>
        </header>

        <%= render "shared/flash" %>

        <main class="flex-1 p-4 sm:p-6 overflow-x-hidden">
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
