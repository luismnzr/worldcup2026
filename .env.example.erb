# Plantilla de variables de entorno. Copia a .env y rellena los valores.
# (.env está en .gitignore; este .erb es solo la plantilla versionada.)

# --- Stripe (inscripción / pagos) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Sidekiq / Action Cable ---
REDIS_URL=redis://localhost:6379/0

# --- Resultados del Mundial (football-data.org) ---
# Saca una API key gratis en https://www.football-data.org/client/register
# Si está vacía, la app funciona igual y la captura de resultados queda manual.
FOOTBALL_DATA_API_TOKEN=

# ───────────────────────── SOLO PRODUCCIÓN ─────────────────────────
# Llave para desencriptar config/credentials.yml.enc (= tu config/master.key local).
RAILS_MASTER_KEY=
# Postgres gestionado (lo da el hosting). En local no hace falta.
# DATABASE_URL=postgres://user:pass@host:5432/worldcup_production
# Dominio público de la app (para links en correos, p. ej. reset de contraseña).
APP_HOST=tu-dominio.com
# Correo transaccional (Postmark). Opcional; si falta, el reset de contraseña fallará.
POSTMARK_API_TOKEN=
# Servir assets compilados desde la app (en PaaS suele ir en "true").
RAILS_SERVE_STATIC_FILES=true
